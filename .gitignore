__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# simulation databases (the ledger lives in git as plain-text records, not binaries)
*.db
*.db-wal
*.db-shm

tree.dot

# experiment workdirs (windows, banks-in-progress; the evidence lives in records/)
work_*/

# operator-fetched big tapes + carved holdouts (digests pinned in records;
# committed fixtures keep the test suite offline) — v4 7
data/btcusdt_1s.csv
data/btcusdt_1m.csv
data/*_1h.csv
data/holdout/*
# the one-shot guard survives clones — a rerun refusal must not depend on
# one machine's disk (v4 6.2)
!data/holdout/*.SHOT
# the forward-holdout declaration is a commitment, not data (v7 4)
!data/holdout/*.FORWARD
# paper-trade runtime state/ledger — a personal track record, not repo data
data/papertrade/*
fetch_err.log
